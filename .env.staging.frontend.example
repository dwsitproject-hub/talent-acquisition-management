# Copy to .env.staging.frontend on the FE staging server (do not commit secrets)
# docker compose -f docker-compose.staging.frontend.yml --env-file .env.staging.frontend up -d --build
#
# Set BACKEND_UPSTREAM to the staging API host:port before start.
# Nginx substitutes it into nginx/nginx.staging.conf at container start.

NODE_ENV=staging

# --- Ports (all required) ---
# App container listen ports
FRONTEND_PORT=3000
CANDIDATE_PORTAL_PORT=3000

# Host publish ports
# frontend/candidate: host -> container PORT above
# nginx: host -> container 80/443 (fixed in nginx.network.conf)
FRONTEND_HOST_PORT=4001
CANDIDATE_PORTAL_HOST_PORT=4002
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# --- API URL baked into Next.js build ---
# Public URL of the nginx /api proxy on this server.
NEXT_PUBLIC_API_URL=https://tas-staging.example.com/api

# --- Document downloads (browser → frontend → backend → Synology) ---
# Leave NEXT_PUBLIC_FILE_BASE_URL empty so the browser stays on this origin.
# Set UPLOADS_PROXY_TARGET on the server to the backend origin (scheme://host:port).
# Do not commit a live address.
NEXT_PUBLIC_FILE_BASE_URL=
UPLOADS_PROXY_TARGET=

# Nginx upstream host:port for the staging API. Required.
BACKEND_UPSTREAM=staging-backend:4001

# Show "Sign in with DWS Hub" on the login page (build-time).
# Direct /login visits stay on the TAS form; Hub tile SSO still uses the callback.
NEXT_PUBLIC_OIDC_ENABLED=true

# --- Optional resource limits ---
FRONTEND_NODE_OPTIONS=--max-old-space-size=512
CANDIDATE_NODE_OPTIONS=--max-old-space-size=512
FRONTEND_CPUS=1.0
FRONTEND_MEM_LIMIT=1g
CANDIDATE_CPUS=1.0
CANDIDATE_MEM_LIMIT=1g
