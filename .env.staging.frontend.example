# Copy to .env.staging.frontend on the FE staging server (do not commit secrets)
# docker compose -f docker-compose.staging.frontend.yml --env-file .env.staging.frontend up -d --build
#
# Before start: verify the nginx upstream backend in nginx/nginx.staging.conf
# matches the staging backend server (BE_HOST:BACKEND_HOST_PORT, e.g. 172.28.92.57:4001)

NODE_ENV=staging

# --- Ports (all required) ---
# App container listen ports
FRONTEND_PORT=3000
CANDIDATE_PORTAL_PORT=3000

# Host publish ports
# frontend/candidate: host -> container PORT above
# nginx: host -> container 80/443 (fixed in nginx.network.conf)
FRONTEND_HOST_PORT=4001
CANDIDATE_PORTAL_HOST_PORT=4002
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# --- API URL baked into Next.js build ---
# Prefer public URL via the nginx /api proxy on THIS server, so API calls and
# /uploads downloads share one origin (e.g. http://172.28.92.56/api)
NEXT_PUBLIC_API_URL=http://172.28.92.56/api

# --- Document download origin (baked into Next.js build) ---
# Set this to send /uploads document downloads DIRECTLY to the backend server,
# bypassing nginx. Leave empty to route downloads the same way as API calls.
# Requires the backend port (4001) to be reachable from users' browsers.
NEXT_PUBLIC_FILE_BASE_URL=http://172.28.92.57:4001

# Show "Sign in with DWS Hub" on the login page (build-time)
NEXT_PUBLIC_OIDC_ENABLED=false

# --- Optional resource limits ---
FRONTEND_NODE_OPTIONS=--max-old-space-size=512
CANDIDATE_NODE_OPTIONS=--max-old-space-size=512
FRONTEND_CPUS=1.0
FRONTEND_MEM_LIMIT=1g
CANDIDATE_CPUS=1.0
CANDIDATE_MEM_LIMIT=1g
