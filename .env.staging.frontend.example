# Copy to .env.staging.frontend on the FE staging server (do not commit secrets)
# docker compose -f docker-compose.staging.frontend.yml --env-file .env.staging.frontend up -d --build
#
# Before start: set nginx upstream backend to BE_HOST:BACKEND_HOST_PORT
# in nginx/nginx.network.conf (e.g. server <BE_IP>:4000)

NODE_ENV=staging

# --- Ports (all required) ---
# App container listen ports
FRONTEND_PORT=3000
CANDIDATE_PORTAL_PORT=3000

# Host publish ports
# frontend/candidate: host -> container PORT above
# nginx: host -> container 80/443 (fixed in nginx.network.conf)
FRONTEND_HOST_PORT=4001
CANDIDATE_PORTAL_HOST_PORT=4002
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# --- API URL baked into Next.js build ---
# Prefer public URL via nginx /api proxy
NEXT_PUBLIC_API_URL=https://tas-staging.example.com/api

# Show "Sign in with DWS Hub" on the login page (build-time)
NEXT_PUBLIC_OIDC_ENABLED=false

# --- Optional resource limits ---
FRONTEND_NODE_OPTIONS=--max-old-space-size=512
CANDIDATE_NODE_OPTIONS=--max-old-space-size=512
FRONTEND_CPUS=1.0
FRONTEND_MEM_LIMIT=1g
CANDIDATE_CPUS=1.0
CANDIDATE_MEM_LIMIT=1g
