# Copy to .env.staging.backend on the BE staging server (do not commit secrets)
# After ApsaraDB cutover:
#   docker compose -f docker-compose.staging.backend.yml --env-file .env.staging.backend -p tas-staging up -d
# Local Postgres 15 rollback (keep volume >= 7 days):
#   docker compose -f docker-compose.staging.backend.yml --env-file .env.staging.backend -p tas-staging --profile local-db up -d

NODE_ENV=staging

# --- Ports (all required) ---
# Container listen ports
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000

# Host publish ports (map host -> container)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=4000

# --- Database (ApsaraDB RDS PostgreSQL 18) ---
# URL-encode the password if it contains @ / # : ? & = (./scripts/setup-database-url.sh .env.staging.backend)
# If the RDS hostname does not resolve inside Docker, use the VPC private IP as the host.
# sslmode=require is typical for ApsaraDB. Use sslmode=no-verify only if the Aliyun CA is missing in the container.
DATABASE_URL=postgresql://tas_user:change_me_encoded_password@rds-host.pg.rds.aliyuncs.com:5432/tas_db?schema=public&sslmode=require&pool_timeout=0&connection_limit=20
# Same URL for dump/restore scripts if you want it separate from the running app:
# STAGING_APSARA_DATABASE_URL=postgresql://tas_user:change_me_encoded_password@rds-host.pg.rds.aliyuncs.com:5432/tas_db?sslmode=require

# Local Docker Postgres 15 (dump source / rollback with --profile local-db)
POSTGRES_HOST=postgres
POSTGRES_USER=tas_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=tas_db
# POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- Secrets (generate new values for staging) ---
# openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_64_chars
# openssl rand -hex 16  (exactly 32 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# --- URLs / CORS (use staging FE host) ---
FRONTEND_URL=https://tas-staging.example.com
CANDIDATE_PORTAL_URL=https://tas-staging.example.com
API_BASE_URL=https://tas-staging.example.com
CORS_ORIGIN=https://tas-staging.example.com
CORS_CREDENTIALS=true

# --- Ops ---
LOG_LEVEL=info
# Set false if prisma migrate deploy errors on PostgreSQL 18 catalogs (schema is already in the dump).
PRISMA_MIGRATE_ON_START=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_LOGIN_WINDOW=900000
RATE_LIMIT_LOGIN_MAX=50
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xls,xlsx

# --- Document storage (Synology NAS) ---
# Staging: /mnt/synology/dev/TAS
# Production: /mnt/synology/TAS  (omit STORAGE_DEPLOYMENT — there is no prod/ folder)
# Do NOT set STORAGE_LOCAL_PATH or UPLOAD_DIR here — they override the composed NAS path.
STORAGE_TYPE=local
STORAGE_SYNOLOGY_ROOT=/mnt/synology
STORAGE_DEPLOYMENT=dev
STORAGE_PROJECT_SLUG=TAS
# Host path bound into the container (must match STORAGE_SYNOLOGY_ROOT inside the container)
STORAGE_HOST_MOUNT=/mnt/synology

# --- DWS Hub OIDC (optional; routes 404 until all three are set) ---
# Public client + PKCE — there is no client_secret
OIDC_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
OIDC_CLIENT_ID=talent-acquisition
OIDC_REDIRECT_URI=https://tas-staging.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
